{
  "name": "twig",
  "version": "1.0.0",
  "description": "Web-based harmonic series explorer",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "npm-run-all --parallel css:watch js:watch worklet:watch node-server",
    "css:watch": "esbuild css/styles.css --bundle --outfile=dist/styles-compiled.css --watch",
    "js:watch": "esbuild js/app.js --bundle --splitting --outdir=dist --entry-names=app --chunk-names=chunks/[name]-[hash] --format=esm --watch",
    "worklet:watch": "esbuild js/dsp/worklets/gate-processor.js --bundle --outfile=dist/gate-processor.js --format=esm --watch",
    "build": "node build.js",
    "js:build": "node build.js",
    "node-server": "node server.js"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "express": "^4.21.2",
    "ws": "^8.21.1"
  },
  "keywords": [
    "audio",
    "synthesizer",
    "spectral",
    "overtones",
    "webaudio"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "esbuild": "^0.27.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "npm-run-all": "^4.1.5"
  }
}
